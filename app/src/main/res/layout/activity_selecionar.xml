<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
   <!-- android:background="@drawable/imagem_trabalho2"-->

    <!-- Ano -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutAno"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ano"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <AutoCompleteTextView
            android:id="@+id/txtAno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Curso -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutCurso"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Curso"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutAno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <AutoCompleteTextView
            android:id="@+id/txtCurso"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>


    <!-- Sala -->


 <com.google.android.material.textfield.TextInputLayout
     android:id="@+id/layoutSala"
     style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_marginTop="344dp"
     android:hint="Sala"
     app:layout_constraintEnd_toEndOf="parent"
     app:layout_constraintHorizontal_bias="0.0"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@id/layoutAno">

     <AutoCompleteTextView
         android:id="@+id/txtSala"
         android:layout_width="match_parent"
         android:layout_height="57dp"
         android:inputType="none" />
 </com.google.android.material.textfield.TextInputLayout>


    <!-- Botão -->

 <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIrHorario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:backgroundTint="@color/verde_principal"
        android:gravity="center"
        android:text="@string/ir_horario"
        android:textAlignment="center"
        android:textColor="@color/branco"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCurso" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIrSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="364dp"
        android:backgroundTint="@color/verde_principal"
        android:gravity="center"
        android:text="@string/ir_sala"
        android:textAlignment="center"
        android:textColor="@color/branco"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCurso" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoltar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/voltar"
        android:gravity="center"
        android:textAlignment="center"
        android:backgroundTint="@color/verde_principal"
        android:textColor="@color/branco"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
