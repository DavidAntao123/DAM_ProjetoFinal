<?xml version="1.0" encoding="utf-8"?>
<!--
Ecrã de autenticação (Login/Registo)
Permite ao utilizador fazer login, registar-se ou entrar como convidado
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- IMAGEM DE FUNDO -->
    <ImageView
        android:id="@+id/imgLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CARD LOGIN -->
    <!--
    CardView que contém o formulário de login
    Funciona como um container com fundo branco semitransparente e cantos arredondados
    Elevação de 8dp para criar efeito de profundidade (sombra)
    -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#EEFFFFFF">

            <!-- TÍTULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activity_login_BemVindo"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/verde_principal"
                android:gravity="center"
                android:layout_marginBottom="20dp"/>

            <!-- EMAIL -->
            <EditText
                android:id="@+id/txtEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/activity_login_Email"
                android:inputType="textEmailAddress"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"/>

            <!-- PASSWORD -->
            <EditText
                android:id="@+id/txtPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/activity_login_Password"
                android:inputType="textPassword"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"/>

            <!-- BOTÃO ENTRAR -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/activity_login_Entrar"
                android:textSize="20sp"
                android:textColor="@color/branco"
                android:textStyle="bold"
                android:backgroundTint="@color/verde_principal"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="2">
            <!-- BOTÃO REGISTAR  -->
            <Button
                android:id="@+id/btnRegistar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="@string/activity_login_Registar"
                android:textSize="18sp"
                android:textColor="@color/branco"
                android:textStyle="bold"
                android:backgroundTint="@color/verde_secundario"/>

            <!-- BOTÃO CONVIDADO  -->
            <Button
                android:id="@+id/btnGuest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="@string/continuar_como_convidado"
                android:textSize="16sp"
                android:textColor="@color/branco"
                android:textStyle="bold"
                android:backgroundTint="@color/verde_secundario"/>
        </LinearLayout>


        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>