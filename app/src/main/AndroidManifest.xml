<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Indica que a aplicação pode usar qualquer tipo de câmara (a da frente e a de trás) -->
    <uses-feature android:name="android.hardware.camera.any" /> <!-- Permissão obrigatória para aceder à câmara -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
    Permissão para escrever no armazenamento externo.
    necessária em versões antigas do Android
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application

        android:usesCleartextTraffic="true"

        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjFinal">

        <!-- LOGIN vai ser o PRIMEIRO ECRA -->
        <activity
            android:name=".Login"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MENU PRINCIPAL -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- SELECIONAR HORÁRIO -->
        <activity
            android:name=".selecionar"
            android:exported="false" />

        <!-- HORÁRIOS -->
        <activity
            android:name=".horarios"
            android:exported="false" />

        <!-- CÂMARA -->
        <activity
            android:name=".cam"
            android:exported="false" />

        <!-- QR CODE -->
        <activity
            android:name=".lerqrcode"
            android:exported="false" />

        <!-- SOBRE -->
        <activity
            android:name=".sobre"
            android:exported="false" />

    </application>

</manifest>

