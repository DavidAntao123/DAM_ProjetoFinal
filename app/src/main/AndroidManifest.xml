<?xml version="1.0" encoding="utf-8"?>

<!--
 AndroidManifest.xml
 Ficheiro principal de configuração da aplicação Android.

 Aqui são definidos:
 permissões da aplicação
 funcionalidades necessárias do dispositivo
 lista de Activities
 qual Activity é o ponto de entrada da aplicação
-->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
         Indica que a aplicação pode utilizar qualquer tipo de câmara
         (frontal ou traseira)
    -->
    <uses-feature android:name="android.hardware.camera.any" />
    <!--
     Permissão obrigatória para permitir acesso à câmara
     utilizada para leitura de QR Codes
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
    Permissão para escrever no armazenamento externo.
    necessária em versões antigas do Android
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Permite ligações HTTP (necessário para comunicar com a API local
      através do endereço 10.0.2.2)
    -->
    <!-- Configurações gerais da aplicação -->
    <application

        android:allowBackup="true"

        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjFinal"
        android:usesCleartextTraffic="true">

        <!--
         Activity de Login
         É o primeiro ecrã da aplicação (LAUNCHER)
        -->
        <activity
            android:name=".Login"
            android:exported="true">
            <!-- Define esta Activity como ponto de entrada da app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity do menu principal -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Activity responsável por selecionar o ano e curso -->
        <activity
            android:name=".selecionar"
            android:exported="false" />

        <!-- Activity que mostra os horários -->
        <activity
            android:name=".horarios"
            android:exported="false" />

        <!-- Activity da câmara para leitura do QR Code -->
        <activity
            android:name=".cam"
            android:exported="false" />

        <!-- Activity para registar -->
        <activity
            android:name=".registar"
            android:exported="false" />



        <!--
        QR CODE
        <activity
            android:name=".lerqrcode"
            android:exported="false" />
        -->

        <!-- Activity Sobre a aplicação -->
        <activity
            android:name=".sobre"
            android:exported="false" />

    </application>

</manifest>

